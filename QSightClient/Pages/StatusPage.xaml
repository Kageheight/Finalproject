<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QSightClient.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20">

        <StackPanel Spacing="12">

            <TextBlock
                Text="Q-Sight Agent Status"
                FontSize="24"
                FontWeight="Bold"/>
            
            <Border Padding="12" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="8">

                    <TextBlock Text="Agent Status"/>
                    <TextBlock x:Name="AgentStatusText" Text="Running"/>

                    <TextBlock Text="Current File"/>
                    <TextBlock x:Name="CurrentFileText" Text="-"/>

                    <TextBlock Text="Queue Size"/>
                    <TextBlock x:Name="QueueSizeText" Text="0"/>

                    <TextBlock Text="Last Message"/>
                    <TextBlock x:Name="LastMessageText" Text="-"/>

                    <ProgressBar
                        x:Name="ScanProgressBar"
                        Minimum="0"
                        Maximum="100"
                        Height="20"
                        Width ="300"
                        HorizontalAlignment="Left"/>

                    <Button
                        Content="Cancel Scan"
                        Click="CancelScan_Click"
                        Width="120"/>

                    <ListView
                        x:Name="QueueList"
                        Height="120"/>

					<!-- 서버 연결 상태 -->
					<TextBlock Text="─────────────────" Opacity="0.3"/>
					<TextBlock Text="서버 대시보드" FontWeight="Bold" FontSize="16"/>

					<TextBlock Text="서버 연결"/>
					<TextBlock x:Name="ServerStatusText" Text="확인 중..."/>

					<TextBlock Text="총 스캔 수 (30일)"/>
					<TextBlock x:Name="TotalScansText" Text="-"/>

					<TextBlock Text="고위험 탐지"/>
					<TextBlock x:Name="HighSeverityText" Text="-"/>

					<TextBlock Text="치명적 위협"/>
					<TextBlock x:Name="CriticalSeverityText" Text="-"/>

					<Button
                        Content="대시보드 새로고침"
                        x:Name="RefreshButton"
                        Click="RefreshDashboard_Click"
                        Width="160"/>

                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>

</Page>